// VOIDBORN data model.
//
// INVARIANT #1 — realm, evolution stage, and the resolved look are NEVER stored.
//   `activeFormKey` is stored; the stage within it is computed from `hammerCount`
//   (see constants/realms). There is deliberately no `realm` or `stage` column anywhere.
// INVARIANT #2 — `StrikeEvent` is append-only and is the source of truth for `hammerCount`.
//   `Practitioner.hammerCount` is a reconcilable cache (jobs/reconcileHammer.ts).
//
// Note on `PractitionerEntity`: the README lists `activeFormKey` on both `Practitioner`
// and `PractitionerEntity`. To keep a single source of truth we put `activeFormKey`,
// `activeDomainKey`, and `activeManifestationPresetId` on `Practitioner`, and reserve
// `PractitionerEntity` for entity-expression selections (active companion/bloodline/demeanor).
// No field has two homes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────── enums

enum Role {
  USER
  ADMIN
}

enum Modality {
  origin
  pull
  push
  core
  cardio
  recovery
}

enum LeakCategory {
  social
  food
  media
  argument
  validation
  doubt
}

enum VowType {
  major
  minor
}

enum VowStatus {
  active
  kept
  broken
  cancelled
}

enum WagerStatus {
  none
  pending
  won
  lost
  settled
}

enum FormTier {
  free
  premium
  transcendent
}

enum CosmeticCategory {
  trail
  aura
  core
  surface
  eyes
  appendages
  orbit
  sigils
}

enum Rarity {
  free
  standard
  premium
  seasonal
  event
}

enum CompanionRarity {
  wandering
  bound
  ancient
  void_herald
}

enum ScrollType {
  lesser
  abyssal
}

enum WagerKind {
  heavenly_restriction
  wagered_ki
}

enum EntitlementKind {
  form
  domain
  bloodline
  cosmetic
  aura
  artifact
}

enum TrialGoalKind {
  breakthrough // deadline-bound campaign toward a named goal
  open_path // rolling maintenance block (no taper, auto-chains)
}

enum TrialExperience {
  novice
  practiced
  seasoned
}

enum TrialStatus {
  active
  completed
  abandoned
}

enum PlannedKind {
  flow // easy session
  surge // quality/intensity session
  pillar // the anchor-day long session
  gate // boss/assessment session
  stillness // recovery — targetReps 0, never strikes
}

enum RealignmentKind {
  ease
  intensify
  realign_missed
}

enum RealignmentStatus {
  proposed
  accepted
  dismissed
}

enum SagaStatus {
  active
  completed
  archived
}

// ─────────────────────────────────────────────────────────────── core

model Practitioner {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  name         String
  role         Role   @default(USER)
  tokenVersion Int    @default(0) // bump to revoke every existing JWT for this practitioner (audit L1)

  // live metrics (motion drivers) — NOT realm/stage
  ki                Int       @default(100) // 0–100 integrity
  shadowLevel       Int       @default(1) // 1–5 intensity
  hammerCount       Int       @default(0) // reconcilable cache of StrikeEvent sum
  streak            Int       @default(0)
  lastLogDate       DateTime?
  anchorCompletedAt DateTime?

  // server-authoritative currency
  crystals Int @default(0)

  // soul-escrow / consequence state (facts, not looks — the look is resolved)
  corruptedSince   DateTime?
  penanceProgress  Int       @default(0) // consecutive full sessions toward cleanse (need 7)
  restrictionScars Int       @default(0)
  dormantSince     DateTime?

  // companion pity counters (server-authoritative)
  pullsSinceAncient Int @default(0)
  pullsSinceHerald  Int @default(0)

  // stored selections (NOT the resolved appearance)
  activeFormKey               String  @default("void")
  activeDomainKey             String  @default("dojo")
  activeManifestationPresetId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // reconcile is last-write-wins by this

  entity           PractitionerEntity?
  bond             Bond?
  sessions         VoidSession[]
  strikes          StrikeEvent[]
  leaks            KiLeak[]
  vows             Vow[]
  trials           Trial[]
  plannedSessions  PlannedSession[]
  realignments     TrialRealignment[]
  soulProfile      SoulProfile?
  sagas            Saga[]
  sagaChapters     SagaChapter[]
  cosmetics        PractitionerCosmetic[]
  presets          ManifestationPreset[]
  forms            PractitionerForm[]
  domains          PractitionerDomain[]
  decor            PractitionerDecor[]
  bloodlines       PractitionerBloodline[]
  companions       PractitionerCompanion[]
  summons          CompanionSummon[]
  wagers           WagerEvent[]
  entitlements     Entitlement[]
  sectMemberships  SectMember[]
  coachReflections CoachReflection[]
  contemplations   Contemplation[]

  @@index([email])
}

/// 1:1 entity-expression record. Stage is NEVER stored here — only active selections.
model PractitionerEntity {
  id                String       @id @default(cuid())
  practitionerId    String       @unique
  practitioner      Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  activeCompanionId String?
  activeBloodlineId String?
  demeanor          String       @default("neutral") // idle mood; expression only
  updatedAt         DateTime     @updatedAt
}

// ─────────────────────────────────────────────────────────────── training / integrity

/// APPEND-ONLY. Source of truth for hammerCount. Never updated or deleted in normal flow.
model StrikeEvent {
  id             String       @id @default(cuid())
  practitionerId String
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  amount         Int // reps that struck; reps:0 NEVER produces a StrikeEvent
  sessionId      String? // optional link to the VoidSession that produced it
  occurredAt     DateTime     @default(now())

  @@index([practitionerId, occurredAt])
}

model VoidSession {
  id             String       @id @default(cuid())
  practitionerId String
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  modality       Modality
  reps           Int // reps:0 ⇒ recovery/stillness ⇒ no StrikeEvent
  rating         Int? // 1–5 subjective
  note           String?
  occurredOn     DateTime     @default(now())
  // client-supplied id for idempotent offline flush
  clientId       String?

  fulfillsPlanned PlannedSession?

  @@unique([practitionerId, clientId])
  @@index([practitionerId, occurredOn])
}

model KiLeak {
  id             String       @id @default(cuid())
  practitionerId String
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  category       LeakCategory
  label          String
  cost           Int // ki debited
  occurredAt     DateTime     @default(now())
  clientId       String?

  @@unique([practitionerId, clientId])
  @@index([practitionerId, occurredAt])
}

model Vow {
  id             String        @id @default(cuid())
  practitionerId String
  practitioner   Practitioner  @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  title          String
  type           VowType
  vowSubtype     String? // e.g. "heavenly_restriction"
  status         VowStatus     @default(active)
  startDate      DateTime      @default(now())
  resolutionDate DateTime
  wagerAmount    Int           @default(0)
  wagerStatus    WagerStatus   @default(none)
  resolvedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  progressions   Progression[]
  trial          Trial?

  @@index([practitionerId, status])
}

model Progression {
  id         String  @id @default(cuid())
  vowId      String
  vow        Vow     @relation(fields: [vowId], references: [id], onDelete: Cascade)
  text       String
  completed  Boolean @default(false)
  orderIndex Int     @default(0)

  @@index([vowId, orderIndex])
}

// ─────────────────────────────────────────────────────────────── trials (forged paths)

/// A sworn training campaign (the Runna-style goal→plan engine, void-skinned).
/// Weeks, phases, and adherence are NEVER stored — derived from startDate + the deterministic
/// generator params via lib/protocol.ts, mirroring the never-store-realm philosophy.
/// Progression ⇒ FREE: no priceModel here, ever (invariant #15).
model Trial {
  id               String          @id @default(cuid())
  practitionerId   String
  practitioner     Practitioner    @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  title            String
  goalKind         TrialGoalKind
  goalLabel        String? // free-text target ("Crest the Iron Mile")
  focusModality    Modality
  experience       TrialExperience
  ability          Json // onboarding probe: { baselineReps: number }
  sessionsPerWeek  Int // 2..7
  pillarDay        Int // 0..6 (0 = Monday) — the long-session day
  volumeDial       Int // 1..5
  difficultyDial   Int // 1..5
  totalWeeks       Int // 6..26
  startDate        DateTime // Monday-aligned UTC midnight
  targetDate       DateTime? // breakthrough date; null for open_path
  status           TrialStatus     @default(active)
  generatorVersion Int             @default(1) // audit: which protocol.ts produced the rows
  vowId            String?         @unique // auto-created linked MAJOR Vow (vowSubtype "trial")
  vow              Vow?            @relation(fields: [vowId], references: [id], onDelete: SetNull)
  chainedFromId    String? // previous trial in the long-term chain (never a dead end)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  plannedSessions PlannedSession[]
  realignments    TrialRealignment[]

  @@index([practitionerId, status])
}

/// A quest in the System Window. Completion is ONLY a link to a real VoidSession —
/// a PlannedSession can never strike by itself (invariants #2/#3/#12 untouched).
model PlannedSession {
  id                   String       @id @default(cuid())
  trialId              String
  trial                Trial        @relation(fields: [trialId], references: [id], onDelete: Cascade)
  practitionerId       String
  practitioner         Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  scheduledOn          DateTime // UTC midnight — single source of "when"; move = update this
  kind                 PlannedKind
  modality             Modality
  targetReps           Int // 0 for stillness (reps:0 ⇒ never strikes)
  title                String // generated flavor ("Gate of the Third Floor")
  fulfilledBySessionId String?      @unique
  fulfilledBy          VoidSession? @relation(fields: [fulfilledBySessionId], references: [id], onDelete: SetNull)
  fulfilledAt          DateTime?
  createdAt            DateTime     @default(now())

  @@index([practitionerId, scheduledOn])
  @@index([trialId, scheduledOn])
}

/// Suggest-only adaptation (the Meridian Reading). NEVER auto-applied — accept/dismiss is a
/// user act, and accept is the only path from suggestion to plan change (invariant #14).
model TrialRealignment {
  id             String            @id @default(cuid())
  trialId        String
  trial          Trial             @relation(fields: [trialId], references: [id], onDelete: Cascade)
  practitionerId String
  practitioner   Practitioner      @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  kind           RealignmentKind
  reason         String // data-grounded sentence shown to the user
  payload        Json // concrete deltas applied on accept (e.g. { volumeDelta: -1 })
  status         RealignmentStatus @default(proposed)
  createdAt      DateTime          @default(now())
  resolvedAt     DateTime?

  @@index([trialId, status])
}

// ─────────────────────────────────────────────────────────────── saga (the chronicle)

/// WOOP/MCII identity record from the Mirror Rite: current self → higher self → inner
/// obstacle → if-then ward. The obstacle taxonomy IS the KiLeak category set; the entity
/// IS the rendered higher self.
model SoulProfile {
  id               String       @id @default(cuid())
  practitionerId   String       @unique
  practitioner     Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  currentSelf      String // who stands here now
  higherSelf       String // the wish / future self the entity embodies
  outcome          String // best imagined outcome
  obstacleCategory LeakCategory // the Inner Demon's nature
  obstacleName     String // the named demon ("The Hollow Scroll")
  obstacleDetail   String // when/how it stirs
  wardPlan         String // if-then implementation intention
  styleKey         String? // chosen arc style ("murim" | "isekai" | "tower" | "regression")
  updatedAt        DateTime     @updatedAt
}

/// A purpose arc. Structure (beats/triggers) is deterministic and authored; only flavor
/// (title/synopsis/teases/prose) is AI. Progression ⇒ FREE forever (invariant #15).
model Saga {
  id             String       @id @default(cuid())
  practitionerId String
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  styleKey       String
  title          String
  synopsis       String
  demonName      String // antagonist = the named inner obstacle
  status         SagaStatus   @default(active)
  spec           Json // merged skeleton: [{ beatKey, trigger, optional }] — never AI-mutated
  promptHash     String // forge cache key (voice.ts pattern)
  source         String       @default("claude") // "claude" | "fallback"
  trialId        String? // bound trial that paces the arc
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  chapters SagaChapter[]

  @@index([practitionerId, status])
}

/// Chapters unlock ONLY from real logged events — unlockedBy is the audit (invariant #13).
/// Locked = unlockedAt null; the tease is visible while locked (Zeigarnik pull).
model SagaChapter {
  id             String       @id @default(cuid())
  sagaId         String
  saga           Saga         @relation(fields: [sagaId], references: [id], onDelete: Cascade)
  practitionerId String
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  index          Int
  beatKey        String // "awakening" | "system_window" | "first_gate" | ...
  title          String
  tease          String // visible while locked
  prose          String? // written at unlock, grounded in the unlocking event
  proseSource    String? // "claude" | "fallback"
  promptHash     String?
  trigger        Json // TriggerSpec (denormalized from spec for the engine)
  optional       Boolean      @default(false) // e.g. the Regression beat may never fire
  unlockedAt     DateTime?
  unlockedBy     Json? // { kind: "gate_fulfilled", sessionId, ... } — real-event audit

  @@unique([sagaId, index])
  @@index([practitionerId, unlockedAt])
}

// ─────────────────────────────────────────────────────────────── entity / customization catalogs

model EntityForm {
  formKey     String             @id // "void" | "beast" | "humanoid" | transcendent keys
  name        String
  tier        FormTier
  stageAssets Json // { riv: "void.riv", artboards: { "1": "...", ... "7": "..." }, inputs: [...] }
  priceModel  Json // { kind: "free" } | { kind: "iap", productKey, priceUsd }
  owners      PractitionerForm[]
}

/// Ownership of a premium form (non-consumable entitlement; void is implicitly owned).
model PractitionerForm {
  id             String       @id @default(cuid())
  practitionerId String
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  formKey        String
  form           EntityForm   @relation(fields: [formKey], references: [formKey], onDelete: Cascade)
  grantedAt      DateTime     @default(now())

  @@unique([practitionerId, formKey])
}

model CosmeticItem {
  itemKey       String                 @id
  category      CosmeticCategory
  name          String
  rarity        Rarity
  defaultTint   String? // hex; tint applied on equip, never per-frame
  layerSpec     Json // how the layer renders (artboard/overlay refs, blend)
  priceModel    Json // { kind:"free" } | { kind:"crystals", amount } | { kind:"iap", productKey, priceUsd }
  setKey        String? // Manifestation Set grouping
  availableFrom DateTime?
  availableTo   DateTime?
  owners        PractitionerCosmetic[]

  @@index([category])
  @@index([setKey])
}

model PractitionerCosmetic {
  id             String       @id @default(cuid())
  practitionerId String
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  cosmeticItemId String
  cosmeticItem   CosmeticItem @relation(fields: [cosmeticItemId], references: [itemKey], onDelete: Cascade)
  acquiredAt     DateTime     @default(now())

  @@unique([practitionerId, cosmeticItemId])
}

/// A named, saved avatarConfig. config holds per-layer { itemKey, tint } + demeanor.
/// It does NOT store a resolved look — resolveManifestation() rebuilds appearance every time.
model ManifestationPreset {
  id             String       @id @default(cuid())
  practitionerId String
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  name           String
  config         Json
  isActive       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([practitionerId])
}

// ─────────────────────────────────────────────────────────────── spaces & premium

model DomainPack {
  domainKey     String               @id // "dojo" | "frozen_wastes" | ...
  name          String
  aesthetic     String
  tapEffect     String
  kiBarMaterial String
  soundscapeKey String
  domainConfig  Json // R3F config (3D phase); parallax layers (2.5D)
  priceModel    Json
  availableFrom DateTime?
  availableTo   DateTime?
  owners        PractitionerDomain[]
}

model PractitionerDomain {
  id             String       @id @default(cuid())
  practitionerId String
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  domainKey      String
  domain         DomainPack   @relation(fields: [domainKey], references: [domainKey], onDelete: Cascade)
  grantedAt      DateTime     @default(now())

  @@unique([practitionerId, domainKey])
}

model SpaceDecor {
  decorKey   String              @id
  name       String
  slot       String // where it sits in the space
  priceModel Json
  owners     PractitionerDecor[]
}

model PractitionerDecor {
  id             String       @id @default(cuid())
  practitionerId String
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  decorKey       String
  decor          SpaceDecor   @relation(fields: [decorKey], references: [decorKey], onDelete: Cascade)
  placement      Json? // position in the space
  acquiredAt     DateTime     @default(now())

  @@unique([practitionerId, decorKey])
}

model Bloodline {
  bloodlineKey String                  @id
  name         String
  stageAssets  Json // alternate stage-artboard set across all seven realms
  lockedSlots  Json // cosmetic slots this lineage owns/locks
  priceModel   Json
  owners       PractitionerBloodline[]
}

model PractitionerBloodline {
  id             String       @id @default(cuid())
  practitionerId String
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  bloodlineKey   String
  bloodline      Bloodline    @relation(fields: [bloodlineKey], references: [bloodlineKey], onDelete: Cascade)
  grantedAt      DateTime     @default(now())

  @@unique([practitionerId, bloodlineKey])
}

// ─────────────────────────────────────────────────────────────── companions (the ONLY RNG system)

model Companion {
  companionKey  String                  @id
  name          String
  rarity        CompanionRarity
  utility       String // human-readable ability
  // which scroll pools include it + relative weight (disclosed rates derive from these)
  inLesserPool  Boolean                 @default(true)
  inAbyssalPool Boolean                 @default(true)
  weight        Int                     @default(100)
  owners        PractitionerCompanion[]
  summons       CompanionSummon[]
}

model PractitionerCompanion {
  id             String       @id @default(cuid())
  practitionerId String
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  companionKey   String
  companion      Companion    @relation(fields: [companionKey], references: [companionKey], onDelete: Cascade)
  acquiredAt     DateTime     @default(now())

  @@unique([practitionerId, companionKey])
}

/// Server-side pull history — the audit trail for gacha. Pity is computed from practitioner counters.
model CompanionSummon {
  id             String       @id @default(cuid())
  practitionerId String
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  scrollType     ScrollType
  companionKey   String
  companion      Companion    @relation(fields: [companionKey], references: [companionKey], onDelete: Cascade)
  wasPity        Boolean      @default(false)
  rolledValue    Float // the RNG roll, for audit
  createdAt      DateTime     @default(now())

  @@index([practitionerId, createdAt])
}

model WagerEvent {
  id                    String       @id @default(cuid())
  practitionerId        String
  practitioner          Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  kind                  WagerKind
  amount                Int // crystals (wagered_ki) or USD cents (heavenly_restriction)
  currency              String       @default("crystal") // "crystal" | "usd"
  status                WagerStatus  @default(pending)
  vowId                 String?
  stripePaymentIntentId String?
  weekOf                DateTime? // for weekly-cap enforcement on wagered_ki
  criterion             Json? // server-evaluated win condition (lib/wager.ts) for wagered_ki
  resolveAt             DateTime? // earliest settle time / horizon; the outcome is derived server-side
  createdAt             DateTime     @default(now())
  settledAt             DateTime?

  @@index([practitionerId, status])
}

/// Non-consumable entitlements granted from verified purchases (RevenueCat). Restorable.
model Entitlement {
  id             String          @id @default(cuid())
  practitionerId String
  practitioner   Practitioner    @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  kind           EntitlementKind
  productKey     String // maps to formKey / domainKey / bloodlineKey / itemKey
  source         String          @default("revenuecat")
  grantedAt      DateTime        @default(now())

  @@unique([practitionerId, kind, productKey])
}

// ─────────────────────────────────────────────────────────────── systems

model Bond {
  id               String       @id @default(cuid())
  practitionerId   String       @unique
  practitioner     Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  value            Int          @default(0) // affinity; unlocks moods, never power
  lastPresenceDate DateTime?
  updatedAt        DateTime     @updatedAt
}

model Season {
  seasonKey String   @id
  name      String
  startsAt  DateTime
  endsAt    DateTime
  dropKeys  Json // cosmetic/domain keys featured this season
}

model Sect {
  sectKey     String       @id @default(cuid())
  name        String
  createdById String
  createdAt   DateTime     @default(now())
  members     SectMember[]
}

model SectMember {
  id             String       @id @default(cuid())
  sectKey        String
  sect           Sect         @relation(fields: [sectKey], references: [sectKey], onDelete: Cascade)
  practitionerId String
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  role           String       @default("member") // "leader" | "member"
  joinedAt       DateTime     @default(now())

  @@unique([sectKey, practitionerId])
}

/// Cache of the Voice of the Void responses (rate-limit + reuse). Never the source of any metric.
model CoachReflection {
  id             String       @id @default(cuid())
  practitionerId String
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  occasion       String // "rebirth" | "ascension" | "return" | "oracle"
  promptHash     String
  body           String
  source         String       @default("claude") // "claude" | "fallback"
  createdAt      DateTime     @default(now())

  @@index([practitionerId, occasion, createdAt])
}

// ─────────────────────────────────────────────── event backbone (Phase 0)
//
// Transactional outbox. A domain event is written in the SAME transaction as the domain change
// (see src/lib/events.ts `emit`), so the two commit atomically — no dual-write problem. A relay
// (src/lib/eventBus.ts `dispatchPending`, run by src/worker.ts) publishes unprocessed events to
// idempotent subscribers. APPEND-ONLY, like StrikeEvent — the audit of what the system reacted to.
model OutboxEvent {
  id             String          @id @default(cuid())
  type           String // DomainEvent['type'] — see src/events/catalog.ts
  practitionerId String? // lets a request drain only its own events (scoped dispatch)
  payload        Json
  occurredAt     DateTime        @default(now())
  processedAt    DateTime? // set by the relay once every interested subscriber has succeeded
  deliveries     EventDelivery[]

  @@index([processedAt, occurredAt])
  @@index([practitionerId, processedAt])
}

// One row per (event, subscriber). The unique constraint makes consumption idempotent: a relay
// retry can never double-apply a subscriber's effect, and a failed delivery is retried until ok.
model EventDelivery {
  id        String      @id @default(cuid())
  eventId   String
  event     OutboxEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  consumer  String
  status    String      @default("ok") // "ok" | "failed" | "dead" (dead = gave up after MAX_ATTEMPTS)
  attempts  Int         @default(0)
  error     String?
  createdAt DateTime    @default(now())

  @@unique([eventId, consumer])
  @@index([consumer, createdAt])
}

// ─────────────────────────────────────────────── The Inner Study (meditation)
// APPEND-ONLY mind-training log — the analogue of StrikeEvent for meditation. A reps:0 act: it
// NEVER strikes, never touches hammerCount or the realm (invariants #1–#3). "Wisdom" is the count
// of these rows (derived, never stored), mirroring realm-from-hammerCount.
model Contemplation {
  id             String       @id @default(cuid())
  practitionerId String
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  hexagram       Int // King Wen number 1–64 (the primary hexagram drawn)
  changing       Int[] // changing line numbers (1–6)
  transformed    Int // King Wen number the changing lines lead to
  note           String?
  kiGain         Int          @default(0)
  day            DateTime // UTC midnight of the meditation — enforces one contemplation per day
  createdAt      DateTime     @default(now())

  @@unique([practitionerId, day])
  @@index([practitionerId, createdAt])
}

// Idempotency ledger for offline-queue mutations that don't have their own dedupe key (seal/anchor).
// The unique [practitionerId, clientId] makes a replayed flush a no-op (audit M1).
model SyncMutation {
  id             String   @id @default(cuid())
  practitionerId String
  clientId       String
  kind           String
  createdAt      DateTime @default(now())

  @@unique([practitionerId, clientId])
}
