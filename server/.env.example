# VOIDBORN server environment. Copy to .env and fill in. JWT_SECRET MUST be set before boot.
DATABASE_URL="postgresql://voidborn:voidborn@127.0.0.1:5432/voidborn?schema=public"
SHADOW_DATABASE_URL="postgresql://voidborn:voidborn@127.0.0.1:5432/voidborn_shadow?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
# Optional — the Voice of the Void falls back to a local, data-grounded reflection when unset.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-4-8"
PORT=4000
# Comma-separated allowlist for CORS in production; empty = reflect origin (dev).
CORS_ORIGINS=""
